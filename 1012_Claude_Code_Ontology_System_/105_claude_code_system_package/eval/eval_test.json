        "code_diff": "const password = 'admin123';"
      },
      "expected": {
        "severity": "Critical",
        "category": "security",
        "detected": true
      }
    },
    {
      "id": "TC-006",
      "name": "타임아웃 미설정 API 호출",
      "category": "logic",
      "input": {
        "code_diff": "const response = await fetch(externalApiUrl);"
