      "name": "경계값 오류 (off-by-one)",
      "category": "edge-case",
      "input": {
        "code_diff": "for (let i = 0; i <= items.length; i++) { process(items[i]); }"
      },
      "expected": {
        "severity": "Critical",
        "category": "edge-case",
        "detected": true
      }
    },
    {
      "id": "TC-010",
      "name": "인증 우회 가능성",
