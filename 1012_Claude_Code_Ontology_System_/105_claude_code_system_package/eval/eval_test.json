      "expected": {
        "severity": "Warning",
        "category": "logic",
        "detected": true
      }
    },
    {
      "id": "TC-007",
      "name": "매직 넘버",
      "category": "logic",
      "input": {
        "code_diff": "if (retryCount > 3) { throw new Error('Too many retries'); }"
