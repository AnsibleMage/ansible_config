{
  "version": "1.0.0",
  "created": "2026-03-17",
  "description": "Phase 3 A3 평가 루프 초기 테스트 셋. 스킬/에이전트 성능 회귀 감지용.",
  "test_cases": [
    {
      "id": "TC-001",
      "name": "SQL 인젝션 감지",
      "category": "security",
      "input": {
        "code_diff": "user_input = request.params['query']\ndb.execute(f'SELECT * FROM users WHERE name = {user_input}')"
      },
      "expected": {
        "severity": "Critical",
        "category": "security",
        "detected": true
      }
    },
    {
      "id": "TC-002",
      "name": "빈 배열 나누기",
      "category": "edge-case",
      "input": {
        "code_diff": "const avg = sum / items.length;"
      },
      "expected": {
        "severity": "Critical",
        "category": "edge-case",
        "detected": true
      }
    },
    {
      "id": "TC-003",
      "name": "XSS 취약점",
      "category": "security",
      "input": {
        "code_diff": "document.innerHTML = userInput;"
      },
      "expected": {
        "severity": "Critical",
        "category": "security",
        "detected": true
      }
    },
    {
      "id": "TC-004",
      "name": "널 포인터 역참조",
      "category": "edge-case",
      "input": {
        "code_diff": "const name = user.profile.name;"
      },
      "expected": {
        "severity": "Critical",
        "category": "edge-case",
        "detected": true
      }
    },
    {
      "id": "TC-005",
      "name": "하드코딩된 비밀번호",
